rules_version = '2';

// Firestore rules: the security boundary (see CLAUDE.md and docs/DECISIONS.md). Hiding a button
// in the UI is not security; this file is.
//
// Identity: `request.auth.uid` (anonymous auth) is the actor. `deviceUuid` is only the stats key
// and is never trusted for permissions.
//
// Topology: room/{code} with players/{uid}, names/{nameKey} and roundScores/{uid}_{round}, so
// every doc is scoped to its room and a player's own docs are keyed by their uid.
//
// Trust model: players write their own scores and the host may correct anyone's. No server
// recomputes totals, and with low total winning a lowered score helps its writer, so `points`
// and `round` are bounded and standings come from roundScores, never the writable `totalScore`.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    /** The room doc, for the subcollection rules. get() doesn't see a sibling write in the same
     * batch (getAfter() does), so the app creates the room before seating anyone in it. */
    function roomData(code) {
      return get(/databases/$(database)/documents/room/$(code)).data;
    }

    function roomNotExpired(code) {
      return roomData(code).expiresAt > request.time;
    }

    function isHost(code) {
      return roomData(code).hostUid == request.auth.uid;
    }

    /** A room code: 5 characters from src/lib/game/room-code.ts's alphabet (no 0/O/1/I). */
    function isRoomCode(code) {
      return code is string && code.matches('^[2-9A-HJ-NP-Z]{5}$');
    }

    /** A local game's id (a UUID). Disjoint from room codes, so a local result can't squat a
     * room's stats and no room can be created at a local game's id. */
    function isLocalGameId(gameId) {
      return gameId is string
        && gameId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
    }

    /** A stats doc is visible only to the players it names. */
    function isParticipant() {
      return request.auth.uid in resource.data.participantUids;
    }

    /** 1..40 characters: MAX_PLAYER_NAME_LENGTH in src/lib/game/rules.ts (tests/rules pins it). */
    function isValidPlayerName(name) {
      return name is string && name.size() >= 1 && name.size() <= 40;
    }

    /** Stored the way cleanPlayerName (src/lib/game/player-names.ts) leaves it: no spaces at the
     * ends and none doubled, so " Juho" can't dodge the unique-name check for "Juho". */
    function isCleanPlayerName(name) {
      return isValidPlayerName(name) && name == name.trim() && !name.matches('.*\\s\\s.*');
    }

    /** A guest seat's id: 'guest-' and a lowercase UUID. An anonymous uid has no '-', so a guest
     * id can never be anyone's signed-in identity or room membership. */
    function isGuestId(id) {
      return id is string
        && id.matches('^guest-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
    }

    /** A name's unique-name record id, the same as playerNameKey in src/lib/game/player-names.ts.
     * lower() only changes A to Z, so the Nordic capitals are folded one by one before it: keep
     * this list and FOLDED_CAPITALS in player-names.ts the same. */
    function nameKeyOf(name) {
      return 'n_' + name.replace('Ä', 'ä').replace('Ö', 'ö').replace('Å', 'å').replace('Ü', 'ü')
        .replace('É', 'é').replace('Ø', 'ø').replace('Æ', 'æ').lower().replace('/', '_');
    }

    /** The read gate: true only for someone seated in this room. */
    function isRoomMember(code) {
      return exists(/databases/$(database)/documents/room/$(code)/players/$(request.auth.uid));
    }

    /** An online game has a room doc. A local game has none: its result reaches Firestore only
     * through the reconnect flush. */
    function roomExists(gameId) {
      return exists(/databases/$(database)/documents/room/$(gameId));
    }

    match /room/{code} {
      // Anyone signed in may get a room by its code, to join. Only `get`, not `read`: `read` also
      // allows `list`, and any stranger could then enumerate every room.
      allow get: if isSignedIn();

      // Play again: a new room may name the finished room its players come from (see
      // isCarriedSeat), but only a finished room the same host ran.
      function isFinishedRoomOfHost(previousCode) {
        return isRoomCode(previousCode)
          && previousCode != code
          && roomData(previousCode).hostUid == request.auth.uid
          && roomData(previousCode).status == 'finished';
      }

      // The creator is the host, at a real room code, from round 1. The expiry is in the future
      // and at most the 6 h lifetime plus an hour of clock skew, so rooms really expire.
      allow create: if isSignedIn()
        && isRoomCode(code)
        && request.resource.data.keys().hasOnly(['code', 'status', 'currentRound', 'hostUid', 'createdAt', 'expiresAt', 'previousRoomCode'])
        && request.resource.data.code == code
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.currentRound == 1
        && request.resource.data.status == 'waiting'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'h')
        && (!('previousRoomCode' in request.resource.data)
          || isFinishedRoomOfHost(request.resource.data.previousRoomCode));

      // Only the host, while the room is live, changes status and currentRound (or sets
      // nextRoomCode once, below). hostUid, code, createdAt and expiresAt never change: a longer
      // expiry would defeat auto-expiry. Rounds move forward one at a time within 1..5 (other
      // values crash every client's contract banner), the game finishes only in round 5, and a
      // finished room never reopens (the /api photo gate trusts 'finished').
      function isRoundUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentRound'])
          && resource.data.status != 'finished'
          && request.resource.data.status in ['waiting', 'playing', 'finished']
          && request.resource.data.currentRound is int
          && request.resource.data.currentRound >= resource.data.currentRound
          && request.resource.data.currentRound <= resource.data.currentRound + 1
          && request.resource.data.currentRound <= 5
          && (request.resource.data.status != 'finished' || request.resource.data.currentRound == 5);
      }

      // Play again: a finished room takes one more write, `nextRoomCode`, pointing its devices at
      // the same host's next room. Set once, and the room stays 'finished'.
      function isNextRoomLink() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextRoomCode'])
          && resource.data.status == 'finished'
          && !('nextRoomCode' in resource.data)
          && isRoomCode(request.resource.data.nextRoomCode)
          && request.resource.data.nextRoomCode != code
          && get(/databases/$(database)/documents/room/$(request.resource.data.nextRoomCode)).data.hostUid == request.auth.uid;
      }

      allow update: if isSignedIn()
        && resource.data.hostUid == request.auth.uid
        && resource.data.expiresAt > request.time
        && (isRoundUpdate() || isNextRoomLink());

      allow delete: if false;

      match /players/{playerUid} {
        allow read: if isSignedIn() && isRoomMember(code);
        // Your own seat, even before it exists: after Play again, a phone in the finished room
        // watches for the seat the host gives it in the next room.
        allow get: if isSignedIn() && playerUid == request.auth.uid;

        // Joining: seating yourself, under your own uid. The shape is exact: this doc is the
        // membership key other rules trust, and a seat without joinOrder would count as a member
        // yet be missing from the app's orderBy('joinOrder') list. The name must be clean, with
        // your own names/ record in the same batch (getAfter sees it), to keep names unique.
        function isOwnSeat() {
          return isSignedIn()
            && playerUid == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid
            && roomNotExpired(code)
            && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'deviceUuid', 'totalScore', 'joinOrder'])
            && request.resource.data.keys().hasAll(['name', 'ownerUid', 'deviceUuid', 'totalScore', 'joinOrder'])
            && isCleanPlayerName(request.resource.data.name)
            && getAfter(
              /databases/$(database)/documents/room/$(code)/names/$(nameKeyOf(request.resource.data.name))
            ).data.ownerUid == request.auth.uid
            && request.resource.data.deviceUuid is string
            && request.resource.data.deviceUuid.size() <= 64
            && request.resource.data.totalScore == 0
            && request.resource.data.joinOrder is int;
        }

        // A guest: a player without a phone, seated and scored by the host. Its id is a guest id
        // (never a uid, so never a member), the host owns it, its deviceUuid is its id (the stats
        // key), and its name record names this seat.
        function isGuestSeat() {
          return isSignedIn()
            && isHost(code)
            && isGuestId(playerUid)
            && roomNotExpired(code)
            && roomData(code).status != 'finished'
            && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'deviceUuid', 'totalScore', 'joinOrder', 'isGuest'])
            && request.resource.data.keys().hasAll(['name', 'ownerUid', 'deviceUuid', 'totalScore', 'joinOrder', 'isGuest'])
            && request.resource.data.isGuest == true
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.deviceUuid == playerUid
            && isCleanPlayerName(request.resource.data.name)
            && getAfter(
              /databases/$(database)/documents/room/$(code)/names/$(nameKeyOf(request.resource.data.name))
            ).data.playerId == playerUid
            && request.resource.data.totalScore == 0
            && request.resource.data.joinOrder is int;
        }

        // Play again: the host seats a player of the finished room here, unchanged, so nobody
        // rejoins. Only into the room its nextRoomCode points at, before the game starts, so no
        // player can be seated in any number of rooms. Guests are carried as guest seats.
        function isCarriedSeat() {
          let previousCode = roomData(code).get('previousRoomCode', '');
          let previousSeat = get(
            /databases/$(database)/documents/room/$(previousCode)/players/$(playerUid)
          ).data;
          return isSignedIn()
            && isHost(code)
            && roomNotExpired(code)
            && roomData(code).status == 'waiting'
            && isRoomCode(previousCode)
            && roomData(previousCode).hostUid == request.auth.uid
            && roomData(previousCode).get('nextRoomCode', '') == code
            && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'deviceUuid', 'totalScore', 'joinOrder'])
            && request.resource.data.keys().hasAll(['name', 'ownerUid', 'deviceUuid', 'totalScore', 'joinOrder'])
            && previousSeat.ownerUid == playerUid
            && request.resource.data.ownerUid == playerUid
            && request.resource.data.name == previousSeat.name
            && request.resource.data.deviceUuid == previousSeat.deviceUuid
            && getAfter(
              /databases/$(database)/documents/room/$(code)/names/$(nameKeyOf(request.resource.data.name))
            ).data.ownerUid == playerUid
            && request.resource.data.totalScore == 0
            && request.resource.data.joinOrder is int;
        }

        allow create: if isOwnSeat() || isGuestSeat() || isCarriedSeat();

        // A player's own running total, or any seat's for the host. Only totalScore may change: a
        // rewritten deviceUuid could steal another device's stats, ownerUid stays with the
        // seat's creator, and a rename would dodge the unique-name records.
        allow update: if isSignedIn()
          && (playerUid == request.auth.uid || isHost(code))
          && roomNotExpired(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalScore'])
          && request.resource.data.totalScore is int
          && request.resource.data.totalScore >= 0;

        // The host removes a stalled or mistaken seat, with its scores, but never their own: the
        // game can't run without the host.
        allow delete: if isSignedIn()
          && isHost(code)
          && roomNotExpired(code)
          && playerUid != request.auth.uid;
      }

      // One record per name in use, keyed by nameKeyOf(name), created with its seat and never
      // updated: a second claim to a name would be an update, so two players can't take it even
      // at the same moment. Anyone signed in may get one (to say "taken"); listing is refused.
      // The host deletes a removed player's record. A guest's record also names its seat
      // (playerId), so the app can tell the name belongs to a guest.
      match /names/{nameKey} {
        function isOwnSeatRecord() {
          return request.resource.data.keys().hasOnly(['ownerUid'])
            && request.resource.data.ownerUid == request.auth.uid
            && nameKey == nameKeyOf(
              getAfter(/databases/$(database)/documents/room/$(code)/players/$(request.auth.uid)).data.name
            );
        }

        function isGuestSeatRecord() {
          let guestId = request.resource.data.playerId;
          let seat = getAfter(/databases/$(database)/documents/room/$(code)/players/$(guestId)).data;
          return isHost(code)
            && request.resource.data.keys().hasOnly(['ownerUid', 'playerId'])
            && request.resource.data.ownerUid == request.auth.uid
            && isGuestId(guestId)
            && seat.ownerUid == request.auth.uid
            && seat.isGuest == true
            && nameKey == nameKeyOf(seat.name);
        }

        // Play again: the record is the carried player's own, as if they had joined, and names
        // the seat the host is creating for them.
        function isCarriedSeatRecord() {
          let playerUid = request.resource.data.ownerUid;
          let seat = getAfter(/databases/$(database)/documents/room/$(code)/players/$(playerUid)).data;
          return isHost(code)
            && request.resource.data.keys().hasOnly(['ownerUid'])
            && seat.ownerUid == playerUid
            && nameKey == nameKeyOf(seat.name);
        }

        allow get: if isSignedIn();
        allow list: if false;
        allow create: if isSignedIn()
          && roomNotExpired(code)
          && (isOwnSeatRecord() || isGuestSeatRecord() || isCarriedSeatRecord());
        allow update: if false;
        allow delete: if isSignedIn() && isHost(code) && roomNotExpired(code);
      }

      match /roundScores/{scoreId} {
        allow read: if isSignedIn() && isRoomMember(code);

        function isValidRoundScore(code, scoreId) {
          return isSignedIn()
            && roomNotExpired(code)
            && roomData(code).status != 'finished'
            && (isRoomMember(code) || isHost(code))
            && request.resource.data.playerId == request.resource.data.ownerUid
            && (request.resource.data.ownerUid == request.auth.uid || isHost(code))
            && request.resource.data.round is int
            && request.resource.data.round >= 1
            && request.resource.data.round <= 5
            && request.resource.data.points is int
            && request.resource.data.points >= 0
            && request.resource.data.points <= 1000
            && request.resource.data.points % 5 == 0
            && scoreId == request.resource.data.ownerUid + '_' + string(request.resource.data.round);
        }

        // Your own score, or anyone's for the host. `playerId == ownerUid` stops a score being
        // written for someone else under either field. The doc id is pinned to {ownerUid}_{round}
        // so there is one score per player per round; extra docs would be summed into the total.
        // The `points` bounds mirror isValidRoundScore in src/lib/game/rules.ts: `<= 1000` is
        // MAX_ROUND_SCORE and `% 5` is ROUND_SCORE_STEP (every card value is a multiple of 5).
        // Change both together; tests/rules imports those constants to pin the pair.
        // Only seated players or the host, while the game runs, for rounds that have started. A
        // player may fill in a missed round (create), but only the host changes an earlier round
        // afterwards, so nobody quietly lowers round 1 in round 5.
        allow create: if isValidRoundScore(code, scoreId)
          && request.resource.data.round <= roomData(code).currentRound;
        allow update: if isValidRoundScore(code, scoreId)
          && (request.resource.data.round == roomData(code).currentRound || isHost(code));

        // Only as part of the host removing a seat (FirestoreGameRepository.removePlayer).
        allow delete: if isSignedIn() && isHost(code) && roomNotExpired(code);
      }
    }

    // Permanent stats. Append-only: create is the only write, even for the writer.
    //
    // Reads: only the players a doc names in `participantUids`, so a query must filter on
    // `participantUids array-contains <uid>`. Head-to-head still works, since opponents are
    // participants in the same games.
    //
    // Who may create (see docs/DECISIONS.md):
    // - Online game (its room exists): only the host, who finishes the game and writes every row,
    //   and a game_player row only for a uid seated in that room, so the host can't invent an
    //   opponent. `deviceUuid` here is the player's auth uid, because players/ is keyed by it and
    //   membership can be checked only against it.
    // - Local game (no room): a UUID id and self-write only (`deviceUuid == request.auth.uid`),
    //   so nobody can forge a row for someone else.
    //
    // A game_player row needs its game_result to exist already, so no row is an orphan. get() and
    // exists() don't see a sibling write in the same batch, so the app writes the result first.
    match /game_result/{gameId} {
      // A get of a result that doesn't exist yet is allowed, so a writer can check before writing
      // (writeGameResult is idempotent).
      allow get: if isSignedIn() && (resource == null || isParticipant());
      allow list: if isSignedIn() && isParticipant();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['gameId', 'finishedAt', 'totalRounds', 'participantUids'])
        && request.resource.data.gameId == gameId
        && request.resource.data.finishedAt is string
        && request.resource.data.totalRounds is int
        && request.resource.data.totalRounds == 5
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() >= 1
        && request.resource.data.participantUids.size() <= 50
        && (
          (roomExists(gameId) && isHost(gameId))
          || (!roomExists(gameId)
            && isLocalGameId(gameId)
            && request.resource.data.participantUids == [request.auth.uid])
        );

      allow update: if false;
      allow delete: if false;
    }

    match /game_player/{playerDocId} {
      allow get: if isSignedIn() && (resource == null || isParticipant());
      allow list: if isSignedIn() && isParticipant();

      allow create: if isSignedIn()
        && request.resource.data.gameId is string
        && request.resource.data.participantUids
          == get(/databases/$(database)/documents/game_result/$(request.resource.data.gameId)).data.participantUids
        && request.resource.data.deviceUuid is string
        && playerDocId == request.resource.data.gameId + '_' + request.resource.data.deviceUuid
        && exists(/databases/$(database)/documents/game_result/$(request.resource.data.gameId))
        && isValidPlayerName(request.resource.data.displayName)
        && request.resource.data.finalScore is int
        && request.resource.data.finalScore >= 0
        && request.resource.data.finalScore <= 5000 // TOTAL_ROUNDS * MAX_ROUND_SCORE
        && request.resource.data.placement is int
        && request.resource.data.placement >= 1
        && request.resource.data.placement <= 50
        && request.resource.data.bestRound is int
        && request.resource.data.bestRound >= 0
        && request.resource.data.bestRound <= 1000
        && request.resource.data.worstRound is int
        && request.resource.data.worstRound >= 0
        && request.resource.data.worstRound <= 1000
        && (
          (roomExists(request.resource.data.gameId)
            && isHost(request.resource.data.gameId)
            && exists(
              /databases/$(database)/documents/room/$(request.resource.data.gameId)/players/$(request.resource.data.deviceUuid)
            ))
          || (!roomExists(request.resource.data.gameId)
            && request.resource.data.deviceUuid == request.auth.uid
            && request.auth.uid in request.resource.data.participantUids)
        );

      allow update: if false;
      allow delete: if false;
    }

    // Global highscores: one public entry per stats row, readable by anyone signed in, ten at a
    // time. An entry must copy its game_player row (and the game's finishedAt) exactly and come
    // from one of that game's players, so the stats-row rules above also decide what reaches the
    // board. Append-only.
    match /leaderboard/{entryId} {
      function matchesItsStatsRow() {
        let row = get(/databases/$(database)/documents/game_player/$(entryId)).data;
        let result = get(/databases/$(database)/documents/game_result/$(row.gameId)).data;
        return request.auth.uid in row.participantUids
          && request.resource.data.displayName == row.displayName
          && request.resource.data.finalScore == row.finalScore
          && request.resource.data.worstRound == row.worstRound
          && request.resource.data.finishedAt == result.finishedAt;
      }

      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.query.limit <= 10;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['displayName', 'finalScore', 'worstRound', 'finishedAt'])
        && matchesItsStatsRow();
      allow update: if false;
      allow delete: if false;
    }
  }
}
