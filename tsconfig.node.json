// The config files, which run in Node.
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "tests/e2e/playwright.config.ts",
    "eslint.config.*",
    "scripts/**/*.ts"
  ],
  "compilerOptions": {
    // The tools transpile these files rather than using Node's type-stripping.
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
