# Fake, safe-to-commit Firebase web config used only when running tests (Vite/Vitest load this
# for `mode: 'test'`). No real project, no secrets — the emulator-backed integration test
# constructs its own separate Firebase App instances, but importing src/lib/firebase.ts (even
# indirectly, e.g. via firestore-repository.ts's `ensureSignedIn` import) initializes its
# module-level singleton app immediately, which throws if these are unset. VITE_USE_EMULATOR
# is left unset here on purpose — that singleton is never exercised against a real network in
# tests, only imported.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-card-scorekeeper.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-card-scorekeeper
VITE_FIREBASE_STORAGE_BUCKET=demo-card-scorekeeper.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
