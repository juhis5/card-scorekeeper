rules_version = '2';

// Firestore rules — THE security boundary for this app (see CLAUDE.md "Golden rules" and
// docs/DECISIONS.md's 2026-07-24 online-auth / topology / read-gate / trust-model entries,
// which this file implements verbatim). The UI hiding a button is not security; this is.
//
// Identity: Firebase Anonymous Auth's `request.auth.uid` is the actor Firestore checks.
// `deviceUuid` carried on player/roundScore docs is the separate, persistent STATS key (see
// the identity store) — it is never trusted for permission decisions, only `auth.uid` is.
//
// Topology: room/{code} (room lookup by code) with two subcollections —
// room/{code}/players/{uid} and room/{code}/roundScores/{uid}_{round} — so every write/read
// under a room is structurally scoped to that room's code, and a player's own docs are keyed
// by their own uid.
//
// Trust model: OWN-SCORE-ONLY writes, plus the host may correct anyone's in their room. There
// is no server here to recompute totals from N per-round docs. Note: under low-total-wins,
// deflating your own score is SELF-SERVING, not "self-defeating" — so `points`/`round` are
// bounded below, and the store derives standings from `roundScores`, never trusting the
// writable `totalScore` field for ranking (see stores/game.ts).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    /** The existing room doc's data, fetched by code — for use from the player/roundScore
     * subcollection rules, which need to look outside their own document. */
    function roomData(code) {
      return get(/databases/$(database)/documents/room/$(code)).data;
    }

    function roomNotExpired(code) {
      return roomData(code).expiresAt > request.time;
    }

    function isHost(code) {
      return roomData(code).hostUid == request.auth.uid;
    }

    /** A room code: 5 characters from src/lib/room-code.ts's alphabet (no 0/O/1/I). */
    function isRoomCode(code) {
      return code is string && code.matches('^[2-9A-HJ-NP-Z]{5}$');
    }

    /** A local game's id: a crypto.randomUUID(). Disjoint from room codes, so a local result can
     * never squat a room code's stats, and a room can never be minted at a local game's id. */
    function isLocalGameId(gameId) {
      return gameId is string
        && gameId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
    }

    /** A stats doc is visible only to the players it names (see the stats section below). */
    function isParticipant() {
      return request.auth.uid in resource.data.participantUids;
    }

    /** 1..40 characters: MAX_PLAYER_NAME_LENGTH in src/lib/rules.ts (tests/rules pins the pair). */
    function isValidPlayerName(name) {
      return name is string && name.size() >= 1 && name.size() <= 40;
    }

    /** Stored the way cleanPlayerName (src/lib/player-names.ts) leaves it: no spaces at the ends
     * and none doubled, so " Juho" can't dodge the unique-name check for "Juho". */
    function isCleanPlayerName(name) {
      return isValidPlayerName(name) && name == name.trim() && !name.matches('.*\\s\\s.*');
    }

    /** A guest seat's id (see players/ below): 'guest-' and a lowercase UUID. An anonymous uid has
     * no '-', so a guest id can never be anyone's signed-in identity or room membership. */
    function isGuestId(id) {
      return id is string
        && id.matches('^guest-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
    }

    /** A name's unique-name record id, the same as playerNameKey in src/lib/player-names.ts.
     * lower() only changes A to Z, so the Nordic capitals are folded here one by one, before it:
     * keep this list and FOLDED_CAPITALS in player-names.ts the same. */
    function nameKeyOf(name) {
      return 'n_' + name.replace('Ä', 'ä').replace('Ö', 'ö').replace('Å', 'å').replace('Ü', 'ü')
        .replace('É', 'é').replace('Ø', 'ø').replace('Æ', 'æ').lower().replace('/', '_');
    }

    /** Room-scoped read gate (not just "any authed user"): true only for someone already
     * seated as a player in this room. */
    function isRoomMember(code) {
      return exists(/databases/$(database)/documents/room/$(code)/players/$(request.auth.uid));
    }

    /** True when a `room/{code}` doc exists for this gameId — i.e. this game was (or still is) a
     * live online room, as opposed to a purely local (offline, single-device) game whose result
     * only ever reaches Firestore via the reconnect flush (see docs/PLAN.md "Reconnect = push
     * final result only"). Used below to decide how much the game_result/game_player create rules
     * CAN verify about the writer for a given gameId. */
    function roomExists(gameId) {
      return exists(/databases/$(database)/documents/room/$(gameId));
    }

    match /room/{code} {
      // Join-by-code discovery: any authed user may look up a room by its KNOWN code — but
      // `read` covers both `get` (single doc) and `list` (collection query); only `get` is
      // granted. Without this split, any authed stranger could getDocs(collection(db,'room'))
      // and enumerate every room (codes, hostUid, ...), defeating join-by-code privacy. The app
      // only ever fetches/subscribes a room by code — never lists the collection.
      allow get: if isSignedIn();

      // Only the creator can mint a room, at a real room code, seeded at round 1 with an honest
      // expiry: in the future, and no later than the 6 h lifetime plus an hour of client clock
      // skew (an open-ended expiry would defeat "rooms auto-expire").
      allow create: if isSignedIn()
        && isRoomCode(code)
        && request.resource.data.keys().hasOnly(['code', 'status', 'currentRound', 'hostUid', 'createdAt', 'expiresAt'])
        && request.resource.data.code == code
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.currentRound == 1
        && request.resource.data.status == 'waiting'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'h');

      // Only the host advances rounds / finishes the game, and only while the room is live.
      // `resource` (not a get()) is enough here — we're already inside this exact document's
      // own rule, no need to fetch it a second time. Field-restricted to exactly what the app
      // ever writes here: status + currentRound (advanceRound/finishGame), or the one-time
      // nextRoomCode (Play again) below. hostUid/code/createdAt/expiresAt are immutable after
      // create — an unbounded expiry extension would undermine "rooms auto-expire"
      // (docs/PLAN.md's Gemini free-tier protection).
      // Values too, not just keys: a round outside 1..5 would crash every client's contract
      // banner, and a finished room must never reopen (the /api photo gate trusts 'finished').
      // Rounds only move forward one at a time, and the game finishes only in round 5.
      function isRoundUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentRound'])
          && resource.data.status != 'finished'
          && request.resource.data.status in ['waiting', 'playing', 'finished']
          && request.resource.data.currentRound is int
          && request.resource.data.currentRound >= resource.data.currentRound
          && request.resource.data.currentRound <= resource.data.currentRound + 1
          && request.resource.data.currentRound <= 5
          && (request.resource.data.status != 'finished' || request.resource.data.currentRound == 5);
      }

      // Play again: a finished room takes one more write, `nextRoomCode`, pointing every device
      // still in it at the room the same host just created. Set once, never changed, and the
      // status stays 'finished', so the room still never reopens.
      function isNextRoomLink() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nextRoomCode'])
          && resource.data.status == 'finished'
          && !('nextRoomCode' in resource.data)
          && isRoomCode(request.resource.data.nextRoomCode)
          && request.resource.data.nextRoomCode != code
          && get(/databases/$(database)/documents/room/$(request.resource.data.nextRoomCode)).data.hostUid == request.auth.uid;
      }

      allow update: if isSignedIn()
        && resource.data.hostUid == request.auth.uid
        && resource.data.expiresAt > request.time
        && (isRoundUpdate() || isNextRoomLink());

      allow delete: if false;

      match /players/{playerUid} {
        allow read: if isSignedIn() && isRoomMember(code);

        // Joining is seating yourself, and nobody may claim an ownerUid that isn't their own uid.
        // The shape is exact: this doc is the membership key every other rule trusts, and a seat
        // missing joinOrder would be invisible to the app's orderBy('joinOrder') subscription
        // while still counting as a member. The seat's name must be clean and come with this
        // player's own record under names/ (written in the same batch), which is what keeps names
        // unique in the room.
        function isOwnSeat() {
          return isSignedIn()
            && playerUid == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid
            && roomNotExpired(code)
            && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'deviceUuid', 'totalScore', 'joinOrder'])
            && request.resource.data.keys().hasAll(['name', 'ownerUid', 'deviceUuid', 'totalScore', 'joinOrder'])
            && isCleanPlayerName(request.resource.data.name)
            && getAfter(
              /databases/$(database)/documents/room/$(code)/names/$(nameKeyOf(request.resource.data.name))
            ).data.ownerUid == request.auth.uid
            && request.resource.data.deviceUuid is string
            && request.resource.data.deviceUuid.size() <= 64
            && request.resource.data.totalScore == 0
            && request.resource.data.joinOrder is int;
        }

        // A guest: a player without a phone, seated by the host, who then scores for them. Its id
        // is a guest id (never a uid, so never a member), it's owned by the host, its deviceUuid
        // is its own id (the stats rows' key), and its name record names this seat.
        function isGuestSeat() {
          return isSignedIn()
            && isHost(code)
            && isGuestId(playerUid)
            && roomNotExpired(code)
            && roomData(code).status != 'finished'
            && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'deviceUuid', 'totalScore', 'joinOrder', 'isGuest'])
            && request.resource.data.keys().hasAll(['name', 'ownerUid', 'deviceUuid', 'totalScore', 'joinOrder', 'isGuest'])
            && request.resource.data.isGuest == true
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.deviceUuid == playerUid
            && isCleanPlayerName(request.resource.data.name)
            && getAfter(
              /databases/$(database)/documents/room/$(code)/names/$(nameKeyOf(request.resource.data.name))
            ).data.playerId == playerUid
            && request.resource.data.totalScore == 0
            && request.resource.data.joinOrder is int;
        }

        allow create: if isOwnSeat() || isGuestSeat();

        // A player's own running total, or any seat's for the host. Only totalScore may change:
        // deviceUuid is the stats trust anchor (a player rewriting it to someone else's key could
        // steal or corrupt that device's stats), ownerUid stays pinned to whoever created the
        // seat, and a rename would slip past the room's unique-name records.
        allow update: if isSignedIn()
          && (playerUid == request.auth.uid || isHost(code))
          && roomNotExpired(code)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalScore'])
          && request.resource.data.totalScore is int
          && request.resource.data.totalScore >= 0;

        // The host removes a stalled or mistaken seat (with its scores, below). Never their own:
        // the game can't run without the host.
        allow delete: if isSignedIn()
          && isHost(code)
          && roomNotExpired(code)
          && playerUid != request.auth.uid;
      }

      // One record per name in use, keyed by nameKeyOf(name): created together with its seat, and
      // never updated, so a second player can't take the same name even at the same moment (their
      // write would be an update). Anyone signed in may check a name, to say "taken" clearly;
      // listing is refused. The host deletes a removed player's record with the seat.
      // A player's own record has only ownerUid; a guest's also names its seat (playerId), which
      // is how the app can say a name belongs to a guest.
      match /names/{nameKey} {
        function isOwnSeatRecord() {
          return request.resource.data.keys().hasOnly(['ownerUid'])
            && request.resource.data.ownerUid == request.auth.uid
            && nameKey == nameKeyOf(
              getAfter(/databases/$(database)/documents/room/$(code)/players/$(request.auth.uid)).data.name
            );
        }

        function isGuestSeatRecord() {
          let guestId = request.resource.data.playerId;
          let seat = getAfter(/databases/$(database)/documents/room/$(code)/players/$(guestId)).data;
          return isHost(code)
            && request.resource.data.keys().hasOnly(['ownerUid', 'playerId'])
            && request.resource.data.ownerUid == request.auth.uid
            && isGuestId(guestId)
            && seat.ownerUid == request.auth.uid
            && seat.isGuest == true
            && nameKey == nameKeyOf(seat.name);
        }

        allow get: if isSignedIn();
        allow list: if false;
        allow create: if isSignedIn()
          && roomNotExpired(code)
          && (isOwnSeatRecord() || isGuestSeatRecord());
        allow update: if false;
        allow delete: if isSignedIn() && isHost(code) && roomNotExpired(code);
      }

      match /roundScores/{scoreId} {
        allow read: if isSignedIn() && isRoomMember(code);

        function isValidRoundScore(code, scoreId) {
          return isSignedIn()
            && roomNotExpired(code)
            && roomData(code).status != 'finished'
            && (isRoomMember(code) || isHost(code))
            && request.resource.data.playerId == request.resource.data.ownerUid
            && (request.resource.data.ownerUid == request.auth.uid || isHost(code))
            && request.resource.data.round is int
            && request.resource.data.round >= 1
            && request.resource.data.round <= 5
            && request.resource.data.points is int
            && request.resource.data.points >= 0
            && request.resource.data.points <= 1000
            && request.resource.data.points % 5 == 0
            && scoreId == request.resource.data.ownerUid + '_' + string(request.resource.data.round);
        }

        // Own-score-only trust model: a player writes their own score; the host may correct
        // anyone's. `playerId == ownerUid` keeps the two fields honest with each other so
        // nobody can write a score doc for a player they aren't, under either field. `points`/
        // `round` are bounded (low-total-wins makes deflating your own score SELF-serving, not
        // self-defeating — there's no server to catch a falsified value otherwise), and the doc
        // id is pinned to `{ownerUid}_{round}` so there is structurally exactly one score per
        // player per round — an arbitrary id would let a client double-count a round via extra
        // sibling docs `runningTotal` would sum together. The `points` bounds mirror
        // `isValidRoundScore` in src/lib/rules.ts: `<= 1000` is MAX_ROUND_SCORE and `% 5` is
        // ROUND_SCORE_STEP (every card value is a multiple of 5). Change both sides together;
        // tests/rules pins the parity by importing those constants.
        // Only seated players (or the host) write, only while the game is running, and only for
        // rounds that have started. A player may fill in a round they missed (create), but only
        // the host may change an earlier round afterwards, so nobody quietly lowers round 1 in
        // round 5.
        allow create: if isValidRoundScore(code, scoreId)
          && request.resource.data.round <= roomData(code).currentRound;
        allow update: if isValidRoundScore(code, scoreId)
          && (request.resource.data.round == roomData(code).currentRound || isHost(code));

        // Only as part of the host removing a seat (FirestoreGameRepository.removePlayer).
        allow delete: if isSignedIn() && isHost(code) && roomNotExpired(code);
      }
    }

    // Permanent stats records (docs/PLAN.md "Stats & history" — a second layer, separate from
    // the transient room above). APPEND-ONLY: `create` is the only write ever allowed; `update`
    // and `delete` are always denied, so a written result can never be edited or removed
    // afterward, even by its own writer.
    //
    // READS are limited to participants: every stats doc carries `participantUids` (the auth uids
    // of the game's players, written by writeGameResult), and only those players can get or list
    // it. Head-to-head still works because a player's opponents are participants in the same
    // games. Queries must filter `participantUids array-contains <uid>` to be allowed.
    //
    // Create-authorization trade-off (see docs/DECISIONS.md): when a gameId corresponds to a
    // room that exists (an online game — the common case), only that room's host may write its
    // stats rows, matching "the host is the one finishing, so it writes all rows" — AND (the
    // forgery fix below) only for a deviceUuid that was actually seated as a real participant in
    // that room, via `exists(room/{gameId}/players/{deviceUuid})`. `deviceUuid` on these rows is
    // therefore the room participant's own AUTH UID (see `firestore-repository.ts`'s
    // `finishGame`), not the separate localStorage `device_uuid` the room's `players` docs carry
    // — the auth uid is the one identity Firestore can actually verify against room membership.
    //
    // When no room exists (a purely local/offline game, only reaching Firestore via the
    // reconnect flush — see docs/PLAN.md "Reconnect = push final result only"), there is no room
    // doc to check a participant against, so the ONLY remaining identity anchor is SELF-WRITE:
    // `deviceUuid == request.auth.uid`. Before this fix, the local branch had no identity check
    // at all (`!roomExists(gameId)` alone authorized the write) — any authed user could forge a
    // permanent win/loss row for any victim's deviceUuid; closed here.
    //
    // `game_player` additionally requires a matching `game_result` to already exist, so a row can
    // never be created as an orphan pointing at a game that was never (yet) finished.
    match /game_result/{gameId} {
      // Only the players a result names can read it. `get` of a result that doesn't exist yet is
      // allowed, so a writer can check before writing (writeGameResult is idempotent).
      allow get: if isSignedIn() && (resource == null || isParticipant());
      allow list: if isSignedIn() && isParticipant();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['gameId', 'finishedAt', 'totalRounds', 'participantUids'])
        && request.resource.data.gameId == gameId
        && request.resource.data.finishedAt is string
        && request.resource.data.totalRounds is int
        && request.resource.data.totalRounds == 5
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() >= 1
        && request.resource.data.participantUids.size() <= 50
        && (
          (roomExists(gameId) && isHost(gameId))
          || (!roomExists(gameId)
            && isLocalGameId(gameId)
            && request.resource.data.participantUids == [request.auth.uid])
        );

      allow update: if false;
      allow delete: if false;
    }

    match /game_player/{playerDocId} {
      allow get: if isSignedIn() && (resource == null || isParticipant());
      allow list: if isSignedIn() && isParticipant();

      allow create: if isSignedIn()
        && request.resource.data.gameId is string
        && request.resource.data.participantUids
          == get(/databases/$(database)/documents/game_result/$(request.resource.data.gameId)).data.participantUids
        && request.resource.data.deviceUuid is string
        && playerDocId == request.resource.data.gameId + '_' + request.resource.data.deviceUuid
        && exists(/databases/$(database)/documents/game_result/$(request.resource.data.gameId))
        && isValidPlayerName(request.resource.data.displayName)
        && request.resource.data.finalScore is int
        && request.resource.data.finalScore >= 0
        && request.resource.data.finalScore <= 5000 // TOTAL_ROUNDS * MAX_ROUND_SCORE
        && request.resource.data.placement is int
        && request.resource.data.placement >= 1
        && request.resource.data.placement <= 50
        && request.resource.data.bestRound is int
        && request.resource.data.bestRound >= 0
        && request.resource.data.bestRound <= 1000
        && request.resource.data.worstRound is int
        && request.resource.data.worstRound >= 0
        && request.resource.data.worstRound <= 1000
        && (
          (roomExists(request.resource.data.gameId)
            && isHost(request.resource.data.gameId)
            && exists(
              /databases/$(database)/documents/room/$(request.resource.data.gameId)/players/$(request.resource.data.deviceUuid)
            ))
          || (!roomExists(request.resource.data.gameId)
            && request.resource.data.deviceUuid == request.auth.uid
            && request.auth.uid in request.resource.data.participantUids)
        );

      allow update: if false;
      allow delete: if false;
    }
  }
}
