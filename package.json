{
  "name": "card-scorekeeper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest --project unit",
    "test:run": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:coverage": "vitest run --project unit --project api --coverage",
    "backfill:highscores": "tsx scripts/backfill-highscores.ts",
    "test:api-load": "tsc -p tsconfig.api.json --noEmit false --outDir node_modules/.tmp/api-build && node --no-experimental-require-module --input-type=module -e \"await import('./node_modules/.tmp/api-build/api/count.js')\"",
    "test:rules": "firebase emulators:exec --only firestore,auth 'vitest run --project rules'",
    "test:integration": "firebase emulators:exec --only firestore,auth 'vitest run --project integration'",
    "e2e": "playwright test -c tests/e2e",
    "test:e2e": "firebase emulators:exec --only firestore,auth 'playwright test -c tests/e2e'",
    "test:e2e:ci": "CI=1 firebase emulators:exec --only firestore,auth 'playwright test -c tests/e2e --project=chromium --project=firefox'",
    "test:visual": "tests/e2e/visual.sh",
    "test:visual:update": "tests/e2e/visual.sh --update-snapshots",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@lucide/vue": "^1.48.0",
    "@sentry/vue": "^11.0.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "jose": "^6.2.12",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "reka-ui": "^2.10.5",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "5.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "firebase-tools": "^15.31.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11",
    "workbox-window": "^7.4.1"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,css,md}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
