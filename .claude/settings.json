{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // .tool_response.filePath // empty') && [ -n \"$f\" ] && [ -f \"$f\" ] && npx --no-install prettier --write --ignore-unknown \"$f\" 2>/dev/null || true",
            "statusMessage": "Prettier formatting…"
          }
        ]
      }
    ]
  }
}
