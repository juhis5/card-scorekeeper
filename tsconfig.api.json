// The /api function runs in Node's native ESM loader on Vercel, so "nodenext" makes a missing
// ".js" on a relative import a type error instead of a production ERR_MODULE_NOT_FOUND.
// Its tests are in tsconfig.vitest.json, which has the vitest globals.
{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["api/**/*.ts"],
  "exclude": ["api/**/*.test.ts"],
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo"
  }
}
