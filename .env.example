# Firebase web config — public by design (see CLAUDE.md). Never put the Gemini key here;
# it lives only in the serverless function's environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to point src/lib/firebase.ts at the local Firestore/Auth emulators
# (see firebase.json) instead of live Firebase — used for local dev against `firebase emulators:start`
# and slice 4b's e2e suite. Leave unset/false in production.
VITE_USE_EMULATOR=
