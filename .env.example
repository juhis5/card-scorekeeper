# Firebase web config — public by design (see CLAUDE.md). Never put the Gemini key here;
# it lives only in the serverless function's environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to point src/lib/data/firebase.ts at the local Firestore/Auth emulators
# (see firebase.json) instead of live Firebase — used for local dev against `firebase emulators:start`
# and the e2e suite (tests/e2e/playwright.config.ts). Leave unset/false in production.
VITE_USE_EMULATOR=

# --- Optional photo-count (/api/count) — function env only, NEVER a VITE_ var, never committed
# with a value (see CLAUDE.md and the vercel-gemini skill). Only needed if the photo-count
# feature is deployed; manual scoring works with none of this.

# Gemini API key — create it with NO billing attached so the free tier's rate limit is the
# safety net (see docs/PLAN.md "Protecting your Gemini free tier"). Make it in a Google Cloud
# project separate from the Firebase one, restricted to the Generative Language API. Never reuse
# the Firebase browser key: that one is public.
GEMINI_API_KEY=

# Optional. Overrides the default model in api/_lib/gemini.ts (DEFAULT_GEMINI_MODEL) when Google
# renames or retires one. Leave unset to use the default.
GEMINI_MODEL=

# A Firebase service-account JSON key (single-line JSON string). Its project_id is what caller ID
# tokens are checked against (api/_lib/id-token.ts), and the Admin SDK uses it to read the room and
# check the caller's seat server-side. Generate via Firebase Console → Project
# Settings → Service Accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT=
